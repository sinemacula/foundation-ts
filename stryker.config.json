{
    "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
    "testRunner": "vitest",
    "ignorePatterns": [
        ".idea",
        ".qlty",
        ".sinemacula",
        "build",
        "coverage",
        "dist"
    ],
    "mutate": [
        "src/**/*.ts",
        "!**/*.test.ts",
        "!**/test-support/**"
    ],
    "thresholds": {
        "high": 95,
        "low": 90,
        "break": 95
    },
    "reporters": ["clear-text", "progress", "html"],
    "htmlReporter": {
        "fileName": "build/mutation/mutation.html"
    },
    "tempDirName": ".stryker-tmp"
}
