    "scripts": {
        "build": "node scripts/build.mjs",
        "build:dist": "node scripts/build.mjs",
        "mutation:scope": "node scripts/mutation-scope.mjs",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:mutation": "stryker run",
        "bench": "vitest bench --run",
        "bench:baseline": "vitest bench --run --outputJson build/bench/baseline.json",
        "bench:compare": "vitest bench --run --compare build/bench/baseline.json",
        "check": "qlty check",
        "fmt": "qlty fmt",
        "smells": "qlty smells",
        "deadcode": "knip",
        "smoke:node": "node smoke/node/run.mjs",
        "smoke:react-native": "npm ci --prefix smoke/react-native && node smoke/react-native/run.mjs",
        "api:report": "npm run build && node scripts/api-report.mjs",
        "api:check": "npm run build && node scripts/api-report.mjs --check",
        "check:pkg": "rm -rf .pack && mkdir -p .pack && npm pack --pack-destination .pack --silent && publint .pack/*.tgz && attw .pack/*.tgz --profile esm-only",
        "prepare": "node scripts/build.mjs"
    },
